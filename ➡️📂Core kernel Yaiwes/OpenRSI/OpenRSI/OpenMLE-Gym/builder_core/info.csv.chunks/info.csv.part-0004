print(Y_scaled.shape)
print(X_scaled.shape)


# 4. MEMBAGI DATA TRAINING & TESTING
test_size = 92
train_size = len(X_scaled_3d) - test_size
X_train_scaled, X_test_scaled = X_scaled_3d[:train_size], X_scaled_3d[train_size:]
y_train_scaled, y_test_scaled = Y_scaled[:train_size], Y_scaled[train_size:]
print(f""Jumlah data training: {len(X_train_scaled)}"")
print(f""Jumlah data testing: {len(X_test_scaled)}"")
print(f""Bentuk X_train: {X_train_scaled.shape}, Bentuk y_train: {y_train_scaled.shape}"")

# 5. MEMBANGUN & MELATIH MODEL LSTM
learning_rate = 0.01
dropout_rate = 0.2
batch_size_val = 64
optimizer_name = 'RMSprop'

# Pilih optimizer
if optimizer_name.lower() == 'adam':
    optimizer = Adam(learning_rate=learning_rate)
elif optimizer_name.lower() == 'sgd':
    optimizer = SGD(learning_rate=learning_rate)
elif optimizer_name.lower() == 'rmsprop':
    optimizer = RMSprop(learning_rate=learning_rate)

# Bangun model LSTM
model = Sequential([
    LSTM(units=100, input_shape=(X_train_scaled.shape[1], X_train_scaled.shape[2]), activation='tanh'),
    Dropout(dropout_rate),
    Dense(units=len(target_cols))
])

model.compile(optimizer=optimizer, loss='mean_squared_error')
model.summary()

print(f""\nMemulai training model GSTARX-LSTM dengan: BATCH_SIZE={batch_size_val}, OPTIMIZER={optimizer_name}, LR={learning_rate}, DROPOUT={dropout_rate}"")
history = model.fit(X_train_scaled, y_train_scaled,
                    epochs=50,
                    batch_size=batch_size_val,
                    validation_data=(X_test_scaled, y_test_scaled),
                    verbose=2)
print(""Training selesai."")


# 6. PREDIKSI DAN EVALUASI (untuk LSTM)
predicted_residuals_scaled = model.predict(X_test_scaled)

# Invers transform hasil prediksi
predicted_residuals = scaler_Y.inverse_transform(predicted_residuals_scaled)

# Ambil residual asli (ehat) dari data test
ehat_test = df2[input_cols[4:]].iloc[train_size:].values

# Hitung prediksi final = ehat_test + prediksi residual
final_predictions = ehat_test + predicted_residuals

# Data aktual
aktual_test = df2.iloc[train_size:][target_cols].values

# Evaluasi dengan RMSE
rmse_scores = []
aktual_cols_names = target_cols
for i in range(aktual_test.shape[1]):
    rmse = np.sqrt(mean_squared_error(aktual_test[:, i], final_predictions[:, i]))
    rmse_scores.append(rmse)
    print(f""RMSE Final (LSTM) untuk {aktual_cols_names[i]}: {rmse:.4f}"")


# 7. MENYIMPAN NILAI RESIDUAL (untuk LSTM)
# === SIMPAN RESIDUAL KE FILE TERPISAH (lokal notebook) ===
residuals = aktual_test - final_predictions
residual_df = pd.DataFrame(residuals, columns=aktual_cols_names, index=df2.index[train_size:])
lr_for_filename = str(learning_rate).replace('.', 'p')
do_for_filename = str(dropout_rate).replace('.', 'p')
filename = f'residuals_LSTM_batch{batch_size_val}_opt{optimizer_name}_lr{lr_for_filename}_do{do_for_filename}.xlsx'
residual_df.to_excel(filename, index=True)
print(f""Residual disimpan ke file: {filename}"")

# === EKSPOR KE FOLDER input/ UNTUK MONITORING ===
resid_mon = residual_df.copy()
resid_mon.columns = ['resid_LSTM_Y1', 'resid_LSTM_Y2', 'resid_LSTM_Y3', 'resid_LSTM_Y4']
resid_mon = resid_mon.reset_index().rename(columns={'index':'Date'})
run_id = pd.Timestamp.now(tz='Asia/Jakarta').strftime('%Y%m%d_%H%M%S')
input_fname = f""resid_LSTM_bs{batch_size_val}_opt{optimizer_name}_lr{lr_for_filename}_do{do_for_filename}_{run_id}.xlsx""
input_fpath = os.path.join(INPUT_DIR_PATH, input_fname)
resid_mon.to_excel(input_fpath, index=False)
print(f""Residual untuk monitoring disimpan ke: {input_fpath}"")

# === BUAT SALINAN INPUT FTMI YANG SUDAH DI-UPDATE RESIDU (PER HP) ===
df_ftmi_src = pd.read_excel(INPUT_HYBRID_PATH.replace('Input Hybrid GSTARX-NN.xlsx','Input FTMI-LSTM.xlsx')) if os.path.exists(INPUT_HYBRID_PATH.replace('Input Hybrid GSTARX-NN.xlsx','Input FTMI-LSTM.xlsx')) else None
if df_ftmi_src is None:
    df_ftmi_src = pd.read_excel(os.path.join(os.path.dirname(OUTPUT_DIR_PATH), 'Input FTMI-LSTM.xlsx'))

df3 = df_ftmi_src.copy()
df3['Date'] = pd.to_datetime(df3['Date'])
df3.set_index('Date', inplace=True)

# --- MINIMAL FIX: normalisasi index & join agar kolom residu ditambahkan ---
residual_df = residual_df.copy()
residual_df.columns = ['resid_LSTM_Y1', 'resid_LSTM_Y2', 'resid_LSTM_Y3', 'resid_LSTM_Y4']

# Samakan granularity ke tanggal (tanpa jam/tz) supaya align
df3.index = pd.to_datetime(df3.index).normalize()
residual_df.index = pd.to_datetime(residual_df.index).normalize()

# Ganti update() -> join(left) agar kolom residu baru ikut ditambahkan jika belum ada
df3 = df3.join(residual_df, how='left')

df3.reset_index(inplace=True)
ftmi_outname = f""Input FTMI-LSTM_bs{batch_size_val}_opt{optimizer_name}_lr{lr_for_filename}_do{do_for_filename}.xlsx""
ftmi_outpath = os.path.join(OUTPUT_DIR_PATH, ftmi_outname)
df3.to_excel(ftmi_outpath, index=False)
print(f""Residual di-append/update ke: {ftmi_outpath}"")

# ?? Pakai file FTMI HASIL OUTPUT sebagai input tahap berikutnya
FTMI_INPUT_PATH = ftmi_outpath


# 8. VISUALISASI HASIL AKHIR (Aktual vs Prediksi Residual-Added pada test set)
import matplotlib.dates as mdates # Import mdates

dates_test = df2.index[train_size:]
lokasi = {'eresid1': 'Lokasi Y1', 'eresid2': 'Lokasi Y2', 'eresid3': 'Lokasi Y3', 'eresid4': 'Lokasi Y4'}
fig, axes = plt.subplots(2, 2, figsize=(20, 12))
fig.suptitle('Perbandingan Data Aktual dan Prediksi GSTARX-LSTM', fontsize=20, y=1.02)
axes = axes.flatten()
for i, ax in enumerate(axes):
    y_key = aktual_cols_names[i]
    ax.plot(dates_test, aktual_test[:, i], label='Data Aktual', marker='o', markersize=4, linestyle='-', linewidth=2)
    ax.plot(dates_test, final_predictions[:, i], label='Prediksi GSTARX-LSTM', marker='^', markersize=4, linestyle='--', linewidth=2)
    ax.set_title(f""{lokasi.get(y_key, y_key)} (RMSE: {rmse_scores[i]:.4f})"", fontsize=16)
    ax.set_xlabel('Tanggal', fontsize=12); ax.set_ylabel('Curah Hujan (mm)', fontsize=12)
    ax.legend(); ax.grid(True, linestyle='--', linewidth=0.5)
    ax.xaxis.set_major_locator(mdates.AutoDateLocator())
    ax.xaxis.set_major_formatter(mdates.DateFormatter('%Y-%m-%d'))
    plt.setp(ax.get_xticklabels(), rotation=30, ha='right')
plt.tight_layout(); plt.show()


# 9. EVALUASI & VISUALISASI Zt (Aktual vs Zt) MENGGUNAKAN FTMI HASIL OUTPUT
df1['Date'] = pd.to_datetime(df1['Date'])

# ?? Baca ulang dari FTMI_INPUT_PATH (hasil output per HP)
df_ftmi_out = pd.read_excel(FTMI_INPUT_PATH)
df3 = df_ftmi_out.copy()
df3['Date'] = pd.to_datetime(df3['Date'])

print(df3.columns) # Add this line to inspect columns

df3['Zt_Y1'] = df3['Ytpred_FTMI_Y1'] + df3['resid_LSTM_Y1']
df3['Zt_Y2'] = df3['Ytpred_FTMI_Y2'] + df3['resid_LSTM_Y2']
df3['Zt_Y3'] = df3['Ytpred_FTMI_Y3'] + df3['resid_LSTM_Y3']
df3['Zt_Y4'] = df3['Ytpred_FTMI_Y4'] + df3['resid_LSTM_Y4']
for col in ['Zt_Y1', 'Zt_Y2', 'Zt_Y3', 'Zt_Y4']:
    df3[col] = df3[col].apply(lambda x: 0 if x < 0 else x)

min_date = df3['Date'].min(); max_date = df3['Date'].max()
df1_comp = df1[(df1['Date'] >= min_date) & (df1['Date'] <= max_date)].copy()
df3_comp = df3[(df3['Date'] >= min_date) & (df3['Date'] <= max_date)].copy()
lokasi_final = {'Y1':'Bangkalan','Y2':'Sampang','Y3':'Pamekasan','Y4':'Sumenep'}
aktual_cols = ['Aktual_Y1', 'Aktual_Y2', 'Aktual_Y3', 'Aktual_Y4']
zt_cols = ['Zt_Y1', 'Zt_Y2', 'Zt_Y3', 'Zt_Y4']
rmse_results, mae_results = {}, {}
for i in range(4):
    ac, zc = aktual_cols[i], zt_cols[i]
    rmse_value = np.sqrt(mean_squared_error(df1_comp[ac], df3_comp[zc]))
    mae_value = mean_absolute_error(df1_comp[ac], df3_comp[zc])
    rmse_results[f'RMSE ({ac} vs {zc})'] = rmse_value
    mae_results[f'MAE ({ac} vs {zc})'] = mae_value
print('--- HASIL EVALUASI FINAL (Zt) ---')
print(f'Hyperparameters: Batch={batch_size_val}, Opt={optimizer_name}, LR={learning_rate}, Dropout={dropout_rate}')
for k,v in rmse_results.items(): print(f""{k}: {v:.4f}"")
for k,v in mae_results.items(): print(f""{k}: {v:.4f}"")
print(f""\nRata-rata RMSE Keseluruhan: {np.mean(list(rmse_results.values())):.4f}"")
print(f""Rata-rata MAE Keseluruhan: {np.mean(list(mae_results.values())):.4f}"")

plt.figure(figsize=(18, 15))
for i in range(4):
    plt.subplot(2, 2, i + 1)
    plt.plot(df1_comp['Date'], df1_comp[aktual_cols[i]], label='Aktual', marker='o', markersize=4, linestyle='-', linewidth=2)
    plt.plot(df3_comp['Date'], df3_comp[zt_cols[i]], label='Prediksi (Zt)', marker='x', markersize=4, linestyle='-', linewidth=2)
    y_key = aktual_cols[i].split('_')[1]
    plt.title(f""Perbandingan di {lokasi_final.get(y_key, y_key)}"", fontsize=16)
    plt.xlabel('Tanggal', fontsize=14); plt.ylabel('Curah Hujan (mm)', fontsize=14)
    plt.legend(); plt.grid(True)
plt.tight_layout(); plt.show()

# === HITUNG MAPE (align by Date index) ===
mape_results = {}

for i in range(4):
    ac, zc = aktual_cols[i], zt_cols[i]

    # selaraskan ke tanggal yang sama
    a = df1_comp.set_index('Date')[ac]
    p = df3_comp.set_index('Date')[zc]
    aligned = pd.concat([a, p], axis=1, join='inner').dropna()
    aligned.columns = ['actual', 'pred']

    if aligned.empty:
        mape_value = np.nan
    else:
        # hindari pembagi nol
        mask = aligned['actual'] != 0
        mape_value = ( (aligned.loc[mask, 'actual'] - aligned.loc[mask, 'pred']).abs()
                      / aligned.loc[mask, 'actual'].abs() ).mean() * 100 if mask.any() else np.nan

    mape_results[f'MAPE ({ac} vs {zc})'] = mape_value

# Cetak
for k, v in mape_results.items():
    print(f""{k}: {np.round(v, 2) if pd.notna(v) else v}%"")
print(f""Rata-rata MAPE Keseluruhan: {np.round(np.nanmean(list(mape_results.values())), 2)}%"")

