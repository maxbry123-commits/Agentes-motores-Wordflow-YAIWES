                &emsp;&emsp;&emsp;&emsp;/images
                &emsp;&emsp;&emsp;&emsp;/labels   &emsp;&emsp;&emsp;&emsp;&emsp;# YOLO format annotations
        &emsp;&emsp;/IR_train
                &emsp;&emsp;&emsp;&emsp;/images
                &emsp;&emsp;&emsp;&emsp;/labels   
        &emsp;&emsp;/val                # Contains both EO and IR images
                &emsp;&emsp;&emsp;&emsp;/images
