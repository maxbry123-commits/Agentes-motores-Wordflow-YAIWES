# Mendefinisikan kolom untuk input dan target model
input_cols = ['w1', 'w2', 'w3', 'w4', 'ehat1', 'ehat2', 'ehat3', 'ehat4']
target_cols = ['eresid1', 'eresid2', 'eresid3', 'eresid4']

# 3. MENYIAPKAN DATA UNTUK MODEL
X = df2[input_cols].values
Y = df2[target_cols].values

scaler_X = MinMaxScaler(feature_range=(0, 1))
X_scaled = scaler_X.fit_transform(X)

scaler_Y = MinMaxScaler(feature_range=(0, 1))
