# ¥Ç©`¥¿¤ÎÕi¤ßÞz¤ß
df = pd.read_csv('train.csv')

# ¥«©`¥Í¥ëÃÜ¶ÈÍÆ¶¨
kde = gaussian_kde(df['Time'].values, bw_method=w)
time = np.linspace(0, 5, 5001)
n_firing = len(df)
n_trial = len(np.unique(df['Trial']))
firing_rate = kde(time) * n_firing / n_trial

# ÍÆ¶¨½Y¹û¤Î¿ÉÒ•»¯
