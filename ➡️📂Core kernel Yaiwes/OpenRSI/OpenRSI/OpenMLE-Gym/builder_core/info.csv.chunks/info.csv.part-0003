  <tr>
   <td>
Action
   </td>
   <td>Light
   </td>
   <td>Heavy
   </td>
  </tr>
  <tr>
   <td>Move
   </td>
   <td>floor(1 + 0.05 * rubble value of target square) power
   </td>
