...

435,1,1708608799.0294633,-0.0090419566258788,-0.4686032235622406,0.0454187504947185,0.9985563394997264,0.0311746764598546,-0.0012816397812029,-0.0437233780945848
436,1,1708608799.09613,-0.0217815805226564,-0.533952534198761,0.0456447973847389,0.998721647029031,0.0289674115330413,-0.0063051074062425,-0.040941500281386
437,1,1708608799.1627967,-0.0217815805226564,-0.533952534198761,0.0456447973847389,0.998721647029031,0.0289674115330413,-0.0063051074062425,-0.040941500281386
438,1,1708608799.229463,-0.0252533182501792,-0.560400664806366,0.041293166577816,0.9987812308427249,0.0289466143132738,-0.009051281765522,-0.0389386791569936
