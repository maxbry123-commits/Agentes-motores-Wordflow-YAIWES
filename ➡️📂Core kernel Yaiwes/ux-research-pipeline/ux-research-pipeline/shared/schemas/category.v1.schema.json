{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ux-research-pipeline.local/schemas/category.v1.json",
  "title": "Category",
  "description": "An axial-coding category — a substantive cluster of themes. Produced by `13-axial-coding`. Stored as part of `3-analysis/_categories.md` (one category = one section).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category_id",
    "name",
    "themes",
    "pinned_respondents"
  ],
  "properties": {
    "category_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$",
      "description": "C01, C02, ..."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "Category name. It should sound specific to this product. NOT 'motivations' / 'pain points' / 'expectations'."
    },
    "description": {
      "type": "string",
      "description": "1–3 paragraphs: what the category covers and how it differs from neighboring ones."
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{2,3}$"
      },
      "description": "Themes within the category."
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis_id", "position"],
        "properties": {
          "axis_id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "position": {
            "type": "string",
            "description": "Name of the pole the category is closer to. For example, 'explicit-control' on the 'control' axis."
          }
        }
      },
      "description": "Binding of the category to axes. A category can lie on several axes at once."
    },
    "pinned_respondents": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "pattern": "^R[0-9]{2,3}$"
      },
      "description": "Respondents that ground the category (≥3 — otherwise the category is questionable)."
    },
    "key_quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "respondent_id", "verbatim", "timecode"],
      "properties": {
        "segment_id": {"type": "string", "pattern": "^seg-[0-9]{4}$"},
        "respondent_id": {"type": "string", "pattern": "^R[0-9]{2,3}$"},
        "verbatim": {"type": "string", "minLength": 1},
        "timecode": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
      },
      "description": "The most characteristic quote for the category. verbatim must match the corresponding `coded-segment.verbatim`."
    },
    "related_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category_id", "relation"],
        "properties": {
          "category_id": {"type": "string", "pattern": "^C[0-9]{2}$"},
          "relation": {
            "type": "string",
            "enum": ["co-occurs", "causes", "modulates", "contradicts", "elaborates"]
          },
          "note": {"type": "string"}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
