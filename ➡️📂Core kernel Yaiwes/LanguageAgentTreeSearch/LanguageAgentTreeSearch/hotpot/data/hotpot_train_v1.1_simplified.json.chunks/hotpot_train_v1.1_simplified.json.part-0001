idge"}, {"question": "When was the school that had David Perkins Page as its first principal founded?", "answer": "1844", "type": "bridge"}, {"question": "Which institution has the most campuses, Georgia Institute of Technology or Budapest University of Technology and Economics?", "answer": "Georgia Institute of Technology", "type": "comparison"}, {"question": "The Singing Fool was released by the entertainment company headquartered in what California town?", "answer": "Burbank", "type": "bridge"}, {"question": "In what New Hampshire county is Cherry Pond in?", "answer": "Coos County", "type": "bridge"}, {"question": "Which case Katzenbach v. McClung or Gitlow v. New York was heard first ?", "answer": "Gitlow v. New York,", "type": "comparison"}, {"question": "Edmond Memorial High School is located in what city whose population was 81,405 as of 2010?", "answer": "Edmond, Oklahoma", "type": "bridge"}, {"question": "Joy Malbon was a journalist who covered the verdict regarding which taxi driver?", "answer": "Rodney Glen King", "type": "bridge"}, {"question": "Above and Beyond is a 1952 American war film about a brigadier general in the United States Air Force, who is best known for being the pilot who flew what plane when it dropped the Little Boy atomic bomb? ", "answer": "Enola Gay", "type": "bridge"}, {"question": "The Prophet, was likely founded as part of Joseph Smith's presidential campaign, and resembled other contemporary Mormon newspapers, other editors include Samuel Brannan, he was an American settler, businessman, journalist, and prominent Mormon who founded which newspaper?", "answer": "California Star", "type": "bridge"}, {"question": "Which documentary has won more Academy Awards, Taxi to the Dark Side or A Life in the Death of Joe Meek?", "answer": "Taxi to the Dark Side", "type": "comparison"}, {"question": "Mission Records was created by which lead singer of The Eagles?", "answer": "Glenn Lewis Frey", "type": "bridge"}, {"question": "Are Sleep Room a