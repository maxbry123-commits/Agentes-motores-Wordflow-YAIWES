dge"}, {"question": "What type of engine does Stanley Hooker and Bristol Proteus have in common?", "answer": "turboprop", "type": "bridge"}, {"question": "Where was the manufacturer of The Republic RC-3 Seabee basedd?", "answer": "Farmingdale, Long Island, New York", "type": "bridge"}, {"question": "Which of the lower keys is served by the bridge that crosses over the Pigeon Key Historic District?", "answer": "Little Duck Key", "type": "bridge"}, {"question": "What song, written by Taylor Swift during her freshman year of high school, was included in her third studio album, \"Speak Now\"?", "answer": "\"Tim McGraw\"", "type": "bridge"}, {"question": "What year did the movie come out that Secrets is notably similar to?", "answer": "1985", "type": "bridge"}, {"question": "What is the release date of the album released by Andrew Wood's band just months after his death?", "answer": "July 19, 1990", "type": "bridge"}, {"question": "Who has written more books, Leon Uris or Wilhelm Reich?", "answer": "Wilhelm Reich", "type": "comparison"}, {"question": "Did Samsara or Portrait of Gina get funded by ABC TV?", "answer": "Portrait of Gina", "type": "comparison"}, {"question": "Who established the University where Cecil Leonard played college football?", "answer": "Booker T. Washington", "type": "bridge"}, {"question": "Which director of a film starring Lindsey Lohan also directed 18 feature films?", "answer": "Paul Schrader", "type": "bridge"}, {"question": "Which film was released first, Iron Will or The Vanishing Prairie?", "answer": "The Vanishing Prairie", "type": "comparison"}, {"question": "But the Flesh is Weak is a 1932 comedy film written by what Welsh composer and actor who became one of the most popular British entertainers of the first half of the 20th Century?", "answer": "Ivor Novello", "type": "bridge"}, {"question": "When is the movie \"Mortal Engines\" coming out that an actor that played in \"Misfits\" is starring in?", "answer": "December 14, 2018", "type":