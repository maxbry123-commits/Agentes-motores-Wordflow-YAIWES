ison"}, {"question": "North Montgomery High School is a part of what Indiana school district?", "answer": "North Montgomery School Corporation", "type": "bridge"}, {"question": "What name can be given to Jersey Budd, a singer-songwriter from Leicester and Leigh Kakaty the founder of American rock band Pop Evil?", "answer": "musician", "type": "comparison"}, {"question": "Are Catcha Lake and Big Dan Mine both located in Canada?", "answer": "yes", "type": "comparison"}, {"question": "Joyce DiDonato (\"n\u00e9e\" Flaherty; born February 13, 1969) is an American operatic lyric-coloratura mezzo-soprano", "answer": "leading opera companies", "type": "bridge"}, {"question": "Across the Bridge of Hope was an album in support of the car bombing that took place in what Northern Irish city?", "answer": "Omagh", "type": "bridge"}, {"question": "What is the name of the affluent area in Cheshire that includes the villages of Bowdon, Wilmslow and Alderley Edge?", "answer": "The Golden Triangle", "type": "bridge"}, {"question": "Merrill Pye was nominated for an Academy Award for what 1959 American thriller that was directed by Alfred Hitchcock?", "answer": "North by Northwest", "type": "bridge"}, {"question": "Akwaaba Music and Joey B are both from what coutry?", "answer": "Ghana", "type": "bridge"}, {"question": "Who, Claudie Haigner\u00e9 and Mark Shuttleworth, is the founder and CEO of Canonical Ltd., the company behind the development of the Linux-based Ubuntu operating system?", "answer": "Mark Richard Shuttleworth", "type": "comparison"}, {"question": "Cigar Aficionado and Weatherwise, are a type of which form of publication/.", "answer": "magazine", "type": "comparison"}, {"question": "What other country besides Poland contains part of the historical and geographical region where Bu\u0142awa is located?", "answer": "the Czech Republic", "type": "bridge"}, {"question": "Which is taller, Trump Tower or Americas Tower?", "answer": "Americas Tower", "type": "comparison"}, {"ques