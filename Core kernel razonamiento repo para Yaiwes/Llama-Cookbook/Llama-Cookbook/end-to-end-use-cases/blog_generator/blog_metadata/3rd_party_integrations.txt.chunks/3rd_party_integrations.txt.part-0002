{"question": "Who is the highest paid player in the NBA", "sql": "SELECT name, CAST(REPLACE(REPLACE(SALARY, '$', ''), ',','') AS INTEGER) AS salary FROM nba_roster WHERE SALARY IS NOT NULL ORDER BY salary DESC LIMIT 1"}
