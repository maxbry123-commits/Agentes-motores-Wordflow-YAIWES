{"question": "What is the average height of NBA players who are at least 6'8", "sql": "SELECT AVG(CAST(SUBSTR(HT, 1, INSTR(HT,' ')-1) AS INTEGER) + CAST(SUBSTR(HT, INSTR(HT,' ')+1) AS FLOAT)/12) as avg_height FROM nba_roster WHERE HT IS NOT NULL AND CAST(SUBSTR(HT, 1, INSTR(HT,' ')-1) AS INTEGER) >= 68;"}
{"question": "What is the average age of all players in the NBA", "sql": "SELECT AVG(AGE) AS average_age FROM nba_roster"}
