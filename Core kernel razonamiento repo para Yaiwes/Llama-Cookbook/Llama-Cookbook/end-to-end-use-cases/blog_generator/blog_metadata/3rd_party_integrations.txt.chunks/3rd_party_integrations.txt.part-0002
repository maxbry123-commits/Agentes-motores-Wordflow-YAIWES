{"question": "What is the height with the most players in the NBA", "sql": "SELECT COUNT(*), CAST(SUBSTR(HT, 1, INSTR(HT,' ')-1) AS INTEGER) as height, COUNT(*) as count FROM nba_roster GROUP BY CAST(SUBSTR(HT, 1, INSTR(HT,' ')-1) AS INTEGER) ORDER BY count DESC LIMIT 1"}
{"question": "What is the number of players on each team in the NBA", "sql": "SELECT Team, COUNT(*) as num_players FROM nba_roster GROUP BY Team;"}
