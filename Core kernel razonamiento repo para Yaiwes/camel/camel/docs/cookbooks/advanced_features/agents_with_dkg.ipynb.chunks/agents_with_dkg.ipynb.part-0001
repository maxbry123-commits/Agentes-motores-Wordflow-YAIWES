            "Subject: Kenvue_Inc, Object: id_2023_10_26, Relationship: REPORTEDEARNINGS, Timestamp: 2023-10-26T00:00:00\n",
            "Subject: Kenvue, Object: id_1_5, Relationship: IMPACTSRETURN, Timestamp: 2023-07-31T00:00:00\n"
          ]
        }
      ],
      "source": [
        "# Query all triplets\n",
        "all_triplets = neo4j_graph.get_triplet()\n",
        "if all_triplets:\n",
        "    for triplet in all_triplets:\n",
        "        print(\n",
        "            f\"Subject: {triplet['subj']}, Object: {triplet['obj']}, \"\n",
        "            f\"Relationship: {triplet['rel']}, \"\n",
        "            f\"Timestamp: {triplet['timestamp']}\"\n",
        "        )\n",
        "else:\n",
        "    print(\"No triplets found in the database.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "oNRyv0JotB8R"
      },
      "source": [
        "## Parameters Investigation.\n",
        "\n",
        "- `max_characters`: The maximum number of characters in a chunk.\n",
        "- `model`: The model to use for the knowledge graph agent. (TogetherAI or Samba Verse)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "kVUI_gwGtB8S",
        "outputId": "d08a6345-8125-4464-fd0f-a82a74d3aced"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "\u001b[33mThe number of elements is: \u001b[39m108\n",
            "\u001b[34m[max_characters:  512] \u001b[33mThe number of chunk elements is: 26\u001b[39m\n",
            "\u001b[34m[max_characters: 1024] \u001b[33mThe number of chunk elements is: 13\u001b[39m\n",
            "\u001b[34m[max_characters: 2048] \u001b[33mThe number of chunk elements is: 7\u001b[39m\n"
          ]
        }
      ],
      "source": [
        "elements = uio.parse_file_or_url(str(example_pdf_files[0]))\n",
        "print(\n",
        "    colorama.Fore.YELLOW\n",
        "    + \"The number of elements is: \"\n",
        "    + colorama.Fore.RESET\n",
        "    + str(len(elements))\n",
        ")\n",
        "\n",
        "# Investigation of the chunk_elements function.\n",
        "for max_characters in [512, 1024, 2048]:\n",
        "    chunk_elements = uio.chunk_elements(\n",
        "        elements,\n",
        "        chunk_type=\"chunk_by_title\",\n",
        "        max_characters=max_characters,\n",
        "    )\n",
        "    print(\n",
        "        colorama.Fore.BLUE\n",
        "        + f\"[max_characters: {max_characters:>4}] \"\n",
        "        + colorama.Fore.YELLOW\n",
        "        + f\"The number of chunk elements is: {len(chunk_elements)}\"\n",
        "        + colorama.Fore.RESET\n",
        "    )"
      ]
    },
