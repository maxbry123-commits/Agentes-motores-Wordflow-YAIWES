])\n    58\t    col4b = fits.Column('vla2', format='QE', array=[[4.0, 5.0], [6.0]])\n    59\t    hdu4 = fits.BinTableHDU.from_columns([col4a, col4b])\n    60\t    hdu4.writeto('test_multi_vla.fits', overwrite=True)\n    61\t    \n    62\t    diff = fits.FITSDiff('test_multi_vla.fits', 'test_multi_vla.fits')\n    63\t    print(f\"  Identical: {diff.identical}\")\n    64\t    assert diff.identical, \"Multiple VLA columns should be identical\"\n    65\t    \n    66\t    if os.path.exists('test_multi_vla.fits'):\n    67\t        os.remove('test_multi_vla.fits')\n    68\t    \n    69\t    # Test case 5: VLA with actual differences\n    70\t    print(\"Test 5: VLA with actual differences\")\n    71\t    col5a = fits.Column('vla_diff', format='QD', array=[[1, 2], [3, 4]])\n    72\t    hdu5a = fits.BinTableHDU.from_columns([col5a])\n    73\t    hdu5a.writeto('test_vla_diff_a.fits', overwrite=True)\n    74\t    \n    75\t    col5b = fits.Column('vla_diff', format='QD', array=[[1, 2], [3, 5]])  # Different last element\n    76\t    hdu5b = fits.BinTableHDU.from_columns([col5b])\n    77\t    hdu5b.writeto('test_vla_diff_b.fits', overwrite=True)\n    78\t    \n    79\t    diff = fits.FITSDiff('test_vla_diff_a.fits', 'test_vla_diff_b.fits')\n    80\t    print(f\"  Identical: {diff.identical}\")\n    81\t    assert not diff.identical, \"VLA with differences should not be identical\"\n    82\t    \n    83\t    if os.path.exists('test_vla_diff_a.fits'):\n    84\t        os.remove('test_vla_diff_a.fits')\n    85\t    if os.path.exists('test_vla_diff_b.fits'):\n    86\t        os.remove('test_vla_diff_b.fits')\n    87\t    \n    88\t    # Test case 6: Compare VLA with different tolerances\n    89\t    print(\"Test 6: VLA with tolerance\")\n    90\t    col6 = fits.Column('vla_tol', format='QE', array=[[1.0], [2.0, 3.0]])\n    91\t    hdu6 = fits.BinTableHDU.from_columns([col6])\n    92\t    hdu6.writeto('test_vla_tol.fits', overwrite=True)\n    93\t    \n    94\t    # Should be identical with default tolerance\n    95\t    diff = fits.FITSDiff('test_vla_tol.fits', 'test_vla_tol.fits', rtol=1e-10, atol=1e-10)\n    96\t    print(f\"  Identical (tight tolerance): {diff.identical}\")\n    97\t    assert diff.identical, \"VLA should be identical with tight tolerance\"\n    98\t    \n    99\t    if os.path.exists('test_vla_tol.fits'):\n   100\t        os.remove('test_vla_tol.fits')\n   101\t    \n   102\t    # Test case 7: VLA in HDU with other extensions\n   103\t    print(\"Test 7: VLA in multi-HDU file\")\n   104\t    # Create a file with primary HDU and table HDU with VLA\n   105\t    primary = fits.PrimaryHDU()\n   106\t    col7 = fits.Column('vla_ext', format='QD', array=[[1, 2], [3]])\n   107\t    table_hdu = fits.BinTableHDU.from_columns([col7])\n   108\t    hdul = fits.HDUList([primary, table_hdu])\n   109\t    hdul.writeto('test_multi_hdu.fits', overwrite=True)\n   110\t    \n   111\t    diff = fits.FITSDiff('test_multi_hdu.fits', 'test_multi_hdu.fits')\n   112\t    print(f\"  Identical: {diff.identical}\")\n   113\t    assert diff.identical, \"Multi-HDU file with VLA should be identical\"\n   114\t    \n   115\t    if os.path.exists('test_multi_hdu.fits'):\n   116\t        os.remove('test_multi_hdu.fits')\n   117\t    \n   118\t    print(\"All VLA edge case tests passed!\")\n   119\t\n   120\tdef test_regression_cases():\n   121\t    \"\"\"Test that the fix doesn't break existing functionality\"\"\"\n   122\t    \n   123\t    print(\"\\n=== Testing Regression Cases ===\")\n   124\t    \n   125\t    # Test case 1: Regular (non-VLA) tables should still work\n   126\t    print(\"Test 1: Regular table comparison\")\n   127\t    col1 = fits.Column('regular', format='I', array=[1, 2, 3])\n   128\t    hdu1 = fits.BinTableHDU.from_columns([col1])\n   129\t    hdu1.writeto('test_regular.fits', overwrite=True)\n   130\t    \n   131\t    diff = fits.FITSDiff('test_regular.fits', 'test_regular.fits')\n   132\t    print(f\"  Identical: {diff.identical}\