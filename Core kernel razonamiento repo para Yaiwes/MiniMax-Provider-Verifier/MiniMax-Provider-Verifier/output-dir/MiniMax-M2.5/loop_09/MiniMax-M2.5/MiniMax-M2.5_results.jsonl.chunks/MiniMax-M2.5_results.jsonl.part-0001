xt } = render(\\n   294→    <Provider>\\n   295→      <Suspense fallback=\\\"loading\\\">\\n   296→        <Counter />\\n   297→      </Suspense>\\n   298→    </Provider>\\n   299→  )\\n   300→\\n   301→  await findByText('loading')\\n   302→  await findByText('commits: 1, count: 0, delayedCount: 0')\\n   303→\\n   304→  fireEvent.click(getByText('button'))\\n   305→  await findByText('loading')\\n   306→  await findByText('commits: 2, count: 1, delayedCount: 1')\\n   307→\\n   308→  fireEvent.click(getByText('button'))\\n   309→  await findByText('loading')\\n   310→  await findByText('commits: 3, count: 2, delayedCount: 2')\\n   311→})\\n   312→\\n   313→it('works with async get without setTimeout', async () => {\\n   314→  const countAtom = atom(0)\\n   315→  const asyncCountAtom = atom(async (get) => {\\n   316→    return get(countAtom)\\n   317→  })\\n   318→\\n   319→  const Counter: React.FC = () => {\\n   320→    const [count, setCount] = useAtom(countAtom)\\n   321→    const [delayedCount] = useAtom(asyncCountAtom)\\n   322→    return (\\n   323→      <>\\n   324→        <div>\\n   325→          count: {count}, delayedCount: {delayedCount}\\n   326→        </div>\\n   327→        <button onClick={() => setCount((c) => c + 1)}>button</button>\\n   328→      </>\\n   329→    )\\n   330→  }\\n   331→\\n   332→  const { getByText, findByText } = render(\\n   333→    <Provider>\\n   334→      <Suspense fallback=\\\"loading\\\">\\n   335→        <Counter />\\n   336→      </Suspense>\\n   337→    </Provider>\\n   338→  )\\n   339→\\n   340→  await findByText('loading')\\n   341→  await findByText('count: 0, delayedCount: 0')\\n   342→\\n   343→  fireEvent.click(getByText('button'))\\n   344→  await findByText('count: 1, delayedCount: 1')\\n   345→\\n   346→  fireEvent.click(getByText('button'))\\n   347→  await findByText('count: 2, delayedCount: 2')\\n   348→})\\n   349→\\n   350→it('shows loading with async set', async () => {\\n   351→  const countAtom = atom(0)\\n   352→  const asyncCountAtom = atom(\\n   353→    (get) => get(countAtom),\\n   354→    async (_get, set, value: number) => {\\n   355→      await new Promise((r) => setTimeout(r, 10))\\n   356→      set(countAtom, value)\\n   357→    }\\n   358→  )\\n   359→\\n   360→  const Counter: React.FC = () => {\\n   361→    const [count, setCount] = useAtom(asyncCountAtom)\\n   362→    return (\\n   363→      <>\\n   364→        <div>\\n   365→          commits: {useCommitCount()}, count: {count}\\n   366→        </div>\\n   367→        <button onClick={() => setCount(count + 1)}>button</button>\\n   368→      </>\\n   369→    )\\n   370→  }\\n   371→\\n   372→  const { getByText, findByText } = render(\\n   373→    <Provider>\\n   374→      <Suspense fallback=\\\"loading\\\">\\n   375→        <Counter />\\n   376→      </Suspense>\\n   377→    </Provider>\\n   378→  )\\n   379→\\n   380→  await findByText('commits: 1, count: 0')\\n   381→\\n   382→  fireEvent.click(getByText('button'))\\n   383→  await findByText('loading')\\n   384→\\n   385→  await findByText('commits: 2, count: 1')\\n   386→})\\n   387→\\n   388→it('uses atoms with tree dependencies', async () => {\\n   389→  const topAtom = atom(0)\\n   390→  const leftAtom = atom((get) => get(topAtom))\\n   391→  const rightAtom = atom(\\n   392→    (get) => get(topAtom),\\n   393→    async (get, set, update: (prev: number) => number) => {\\n   394→      await new Promise((r) => setTimeout(r, 10))\\n   395→      set(topAtom, update(get(topAtom)))\\n   396→    }\\n   397→  )\\n   398→\\n   399→  const Counter: React.FC = () => {\\n   400→    const [count] = useAtom(leftAtom)\\n   401→    const [, setCount] = useAtom(rightAtom)\\n   402→    return (\\n   403→      <>\\n   404→        <div>\\n   405→          commits: {useCommitCount()}, count: {count}\\n   406→        </div>\\n   407→        <button onClick={() => setCount((c) => c + 1)}>button</button>\\n   408→      </>\\n   409→    )\\n   410→  }\\n   411→\\n  