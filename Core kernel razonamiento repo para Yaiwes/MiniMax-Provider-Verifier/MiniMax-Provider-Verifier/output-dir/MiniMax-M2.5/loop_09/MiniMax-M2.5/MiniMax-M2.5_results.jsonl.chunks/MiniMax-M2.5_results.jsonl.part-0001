xpect(anchor.props.href).toBe(\\\"/contact/1\\\");\\n    });\\n\\n    it('should not be active when to=\\\"../id\\\" resolves to different pathname', () => {\\n      let renderer: TestRenderer.ReactTestRenderer;\\n      TestRenderer.act(() => {\\n        renderer = TestRenderer.create(\\n          <MemoryRouter initialEntries={[\\\"/contact/2\\\"]}>\\n            <Routes>\\n              <Route\\n                path=\\\"/contact/:id\\\"\\n                element={\\n                  <NavLink\\n                    to=\\\"../1\\\"\\n                    relative=\\\"path\\\"\\n                    className={({ isActive }) => isActive ? \\\"active\\\" : \\\"inactive\\\"}\\n                  >\\n                    Contact 1\\n                  </NavLink>\\n                }\\n              />\\n            </Routes>\\n          </MemoryRouter>\\n        );\\n      });\\n\\n      let anchor = renderer.root.findByType(\\\"a\\\");\\n      expect(anchor.props.className).toBe(\\\"inactive\\\");\\n      expect(anchor.props.href).toBe(\\\"/contact/1\\\");\\n    });\\n\\n    it('should work with nested routes', () => {\\n      let renderer: TestRenderer.ReactTestRenderer;\\n      TestRenderer.act(() => {\\n        renderer = TestRenderer.create(\\n          <MemoryRouter initialEntries={[\\\"/app/users/123/profile\\\"]}>\\n            <Routes>\\n              <Route path=\\\"/app/users/:userId/*\\\" element={<UserLayout />} />\\n            </Routes>\\n          </MemoryRouter>\\n        );\\n      });\\n\\n      let anchor = renderer.root.findByType(\\\"a\\\");\\n      expect(anchor.props.className).toBe(\\\"active\\\");\\n      expect(anchor.props.href).toBe(\\\"/app/users/123\\\");\\n\\n      function UserLayout() {\\n        return (\\n          <div>\\n            <NavLink\\n              to=\\\"../../123\\\"\\n              relative=\\\"path\\\"\\n              className={({ isActive }) => isActive ? \\\"active\\\" : \\\"inactive\\\"}\\n            >\\n              Use