ot the flag is required\n   119→func (f *IntSliceFlag) IsRequired() bool {\n   120→\treturn f.Required\n   121→}\n   122→\n   123→// TakesValue returns true of the flag takes a value, otherwise false\n   124→func (f *IntSliceFlag) TakesValue() bool {\n   125→\treturn true\n   126→}\n   127→\n   128→// GetUsage returns the usage string for the flag\n   129→func (f IntSliceFlag) GetUsage() string {\n   130→\treturn f.Usage\n   131→}\n   132→\n   133→// GetValue returns the flags value as string representation and an empty\n   134→// string if the flag takes no value at all.\n   135→func (f *IntSliceFlag) GetValue() string {\n   136→\tif f.Value != nil {\n   137→\t\treturn f.Value.String()\n   138→\t}\n   139→\treturn \"\"\n   140→}\n   141→\n   142→// IsVisible returns true if the flag is not hidden, otherwise false\n   143→func (f *IntSliceFlag) IsVisible() bool {\n   144→\treturn !f.Hidden\n   145→}\n   146→\n   147→// GetDefaultText returns the default text for this flag\n   148→func (f *IntSliceFlag) GetDefaultText() string {\n   149→\tif f.DefaultText != \"\" {\n   150→\t\treturn f.DefaultText\n   151→\t}\n   152→\treturn f.GetValue()\n   153→}\n   154→\n   155→// GetEnvVars returns the env vars for this flag\n   156→func (f *IntSliceFlag) GetEnvVars() []string {\n   157→\treturn f.EnvVars\n   158→}\n   159→\n   160→// Apply populates the flag given the flag set and environment\n   161→func (f *IntSliceFlag) Apply(set *flag.FlagSet) error {\n   162→\tif val, ok := flagFromEnvOrFile(f.EnvVars, f.FilePath); ok {\n   163→\t\tf.Value = &IntSlice{}\n   164→\n   165→\t\tfor _, s := range strings.Split(val, \",\") {\n   166→\t\t\tif err := f.Value.Set(strings.TrimSpace(s)); err != nil {\n   167→\t\t\t\treturn fmt.Errorf(\"could not parse %q as int slice value for flag %s: %s\", val, f.Name, err)\n   168→\t\t\t}\n   169→\t\t}\n   170→\n   171→\t\t// Set this to false so that we reset the slice if we then set values from\n   172→\t\t// flags that have already been set by 