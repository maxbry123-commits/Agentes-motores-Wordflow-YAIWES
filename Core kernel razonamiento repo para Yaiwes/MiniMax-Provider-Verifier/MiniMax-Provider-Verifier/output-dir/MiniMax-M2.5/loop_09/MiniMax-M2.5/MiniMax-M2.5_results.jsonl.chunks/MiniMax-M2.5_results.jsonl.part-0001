ln!(\\\"{}\\\", test_code);\\n\\n    // The issue description:\\n    // When hovering over the \\\"c1\\\" in \\\"..c1\\\", the \\\"Inline variable\\\" code action is offered 3 times\\n    // Some offer incorrect replacements like:\\n    // 1. \\\"let c1 = Couple(lCouple(..c1, r: 1)1, r: 1)\\\" - mangled text\\n    // 2. \\\"let c1 = Couple(l:Couple(..c1, r: 1), r: 1)\\\" - when cursor on different position\\n\\n    println!(\\\"\\\\nProblem: When offering 'Inline variable' action on 'c1' in '..c1' part:\\\");\\n    println!(\\\"- Action is offered multiple times\\\");\\n    println!(\\\"- Some replacements are incorrect/mangled\\\");\\n    println!(\\\"- Expected: Only one correct inline action should be offered\\\");\\n\\n    // Check if we've exceeded the timeout\\n    if start_time.elapsed() > timeout {\\n        println!(\\\"TIMEOUT: Script exceeded 60 seconds\\\");\\n        return;\\n    }\\n\\n    println!(\\\"\\\\nNext steps:\\\");\\n    println!(\\\"1. Analyze the InlineVariable code action implementation\\\");\\n    println!(\\\"2. Find why it's generating multiple incorrect actions for record update syntax\\\");\\n    println!(\\\"3. Fix the logic to properly handle record update arguments\\\");\\n\\n    println!(\\\"Script completed in {:?}\\\", start_time.elapsed());\\n}\"}"}}]}, {"role": "tool", "content": "{\"result\": \"<?xml version=\\\"1.0\\\" ?>\\n<result>\\n  <Content>File created successfully at: /workspace/gleam/reproduce_issue.rs</Content>\\n</result>\"}", "name": "Write", "tool_call_id": "Write:0"}, {"role": "assistant", "content": "", "tool_calls": [{"id": "Bash:0", "type": "function", "function": {"name": "Bash", "arguments": "{\"command\": \"rustc reproduce_issue.rs && ./reproduce_issue\", \"description\": \"Run the reproduce script to confirm understanding of the issue\"}"}}]}, {"role": "tool", "content": "{\"TEXT\": \"Reproducing inline variable issue with record update arguments\\nTest code:\\n\\ntype Couple {\\n  Couple(l: Int, r: Int)