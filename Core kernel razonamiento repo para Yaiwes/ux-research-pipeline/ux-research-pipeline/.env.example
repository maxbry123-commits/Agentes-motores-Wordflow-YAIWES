# ux-research-pipeline — environment variables
#
# This is a template. Copy it to `.env` and fill in only what you need.
# With the default config (analysis.coding_mode = agent in project-config.yaml),
# the agent does all the analytical steps in its own context — coding, axial
# coding, the paradigm model, typology, findings, the report. External APIs are
# needed only for two specialized tasks:
#   • transcribing audio/video (Mistral Voxtral),
#   • analyzing UI screenshots via a VLM (Gemini, optional).
# Everything else needs no LLM keys at all.

# ---- STT (needed only if you have audio/video in `0-input/` or `2-interviews/`) ----
# Mistral Voxtral for transcription (used by the ux-transcribe skill).
MISTRAL_API_KEY=

# ---- VLM (needed only if enable_screen_vlm: true) ----
# Gemini for analyzing UI screenshots (`08-screen-vlm`).
GEMINI_API_KEY=

# ---- LLM backends (OPTIONAL) ----
# Needed ONLY if project-config.yaml sets analysis.coding_mode: external, i.e.
# coding is delegated to the `transcript-coding` skill (its own Pydantic
# validator, calling OpenAI / Anthropic). With the default (coding_mode: agent)
# these are unused.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Storage ----
# Local path to the root that holds all research projects.
# If unset, the agent uses <workspace>/research-projects/.
# It is good practice to point this at e.g. ~/research-projects/ so your project
# data lives separately from the framework code.
RESEARCH_PROJECTS_ROOT=

# Path to a canonical, shared codebook (so a team can reuse codes across
# projects). Keep it in a separate repository or shared drive.
CODING_VOCAB_PATH=
