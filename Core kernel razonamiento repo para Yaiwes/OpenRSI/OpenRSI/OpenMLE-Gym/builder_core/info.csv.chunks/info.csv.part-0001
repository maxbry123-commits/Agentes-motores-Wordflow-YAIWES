```
from sklearn.preprocessing import LabelEncoder

encoder = LabelEncoder()

encoder.fit(train_features['addr_do'].unique())
train_features['addr_do'] = encoder.transform(train_features['addr_do'])
test_features['addr_do'] = encoder.transform(test_features['addr_do'])

encoder.fit(train_features['addr_si'].unique())
train_features['addr_si'] = encoder.transform(train_features['addr_si'])
test_features['addr_si'] = encoder.transform(test_features['addr_si'])

encoder.fit(train_features['Apartment_usage'].unique())
train_features['Apartment_usage'] = encoder.transform(train_features['Apartment_usage'])
test_features['Apartment_usage'] = encoder.transform(test_features['Apartment_usage'])

encoder.fit(train_features['Share_auction_YorN'].unique())
train_features['Share_auction_YorN'] = encoder.transform(train_features['Share_auction_YorN'])
test_features['Share_auction_YorN'] = encoder.transform(test_features['Share_auction_YorN'])

