    "forensic_ledger": {
      "required_each_output": ["output number", "family", "segment", "source commit", "files attempted", "files completed", "bytes transferred", "source SHA", "destination commit", "last output", "next output", "next exact file or segment", "errors/retries"],
      "dual_history": {"chat_history": "Cumulative short status only.", "github_history": "Authoritative machine-readable forensic ledger."}
