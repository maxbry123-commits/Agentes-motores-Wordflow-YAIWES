    "current_state": {"last_output":3,"current_family":"01-root-manifests","completed_source_files":["pnpm-workspace.yaml","node-version.mjs",".npmrc",".oxfmtrc.jsonc"],"next_output":4,"next_exact_source_file":".oxlintrc.json","then":".gitattributes, package.json, openclaw.mjs, pnpm-lock.yaml and remaining root manifests"},
    "recovery_protocol": ["Read LEDGER.json first.", "Locate last_output and next_output.", "Resume at next_exact_source_file.", "Never overwrite verified content without recording why.", "Record every batch, byte count, source SHA, destination commit and next recovery point.", "At completion compare reconstructed tree against the pinned source manifest."]
